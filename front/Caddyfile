# Point d'entrée unique de la démo en production : tout est servi sur la même origine,
# donc aucune configuration CORS. Le HTTPS est géré en amont par le Caddy du serveur.
{
	admin off
	auto_https off
}

:80 {
	# Démo : inutile de l'indexer.
	header X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		reverse_proxy api:80
	}

	# Flux temps réel : pas de compression ni de mise en tampon.
	handle /.well-known/mercure* {
		reverse_proxy mercure:80 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip

		# Les fichiers du build portent une empreinte dans leur nom : cache long.
		@hashed path_regexp -[a-zA-Z0-9_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Application monopage : toute route inconnue rend index.html.
		try_files {path} /index.html
		file_server
	}
}
